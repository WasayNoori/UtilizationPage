@page
@model SupportUtilizationModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Support Utilization Data";
}
@Html.AntiForgeryToken()

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div style="font-family: 'Poppins', sans-serif; font-weight: 300; color: #0d6efd; font-size: 1.1rem; margin-bottom: 5px;">Hawk Ridge Systems Engineering</div>
            <div class="d-flex align-items-center">
                <h1 class="page-title mb-0">HRS Tech Support Utilization</h1>
                <button id="refreshButton" class="btn btn-link btn-sm p-0 ms-2" style="color: #0d6efd; font-size: 1.2rem;" title="Reload the schedule">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
            <div class="d-flex flex-column">
                <div class="fs-4 text-dark">
                    Hello <span id="userGreeting" class="fw-bold">@Model.UserName</span>
                </div>
                @* Same style as "Total Logged Today by Team" on the main page *@
                <div id="otgHoursToday" style="font-size: 0.9rem; color: #198754; font-weight: 500;">
                    Total OTG Hours Scheduled for Team Today: Loading...
                </div>
            </div>
        </div>
        <div class="d-flex flex-column align-items-end">
            @* Same spot and style as the main page's "Last Updated" line *@
            <div id="wfmLastSync" style="font-size: 0.75rem; color: #6c757d; margin-bottom: 5px;">Checking last sync...</div>
            <div class="d-flex align-items-center gap-3">
                @* Plain label-over-select filters, matching "Select User" on the main page *@
                <div class="user-select-container">
                    <label for="wfmGroupBy" class="form-label me-2">Show:</label>
                    <select id="wfmGroupBy" class="form-select" style="width: auto; min-width: 160px;">
                        <option value="agent">By agent</option>
                        <option value="group">By pod / group</option>
                    </select>
                </div>
                <div class="user-select-container">
                    <label for="wfmActivity" class="form-label me-2">Activity:</label>
                    <select id="wfmActivity" class="form-select" style="width: auto; min-width: 180px;">
                        <option value="all">All activities</option>
                    </select>
                </div>
                <div class="time-filter-container d-flex gap-3" style="background-color: #f8f9fa; padding: 10px 15px; border-radius: 5px; border: 1px solid #dee2e6;">
                  <div>
                    <label for="yearFilter" class="form-label me-2" style="font-weight: 500; color: #0d6efd;">Year:</label>
                    <select id="yearFilter" class="form-select" style="width: auto; border-color: #0d6efd;" onchange="handleYearChange(this.value)">
                        @* Filled by buildYearOptions() from the browser's date *@
                    </select>
                  </div>
                  <div>
                    <label for="timeFilter" class="form-label me-2" style="font-weight: 500; color: #0d6efd;">Time Period:</label>
                    <select id="timeFilter" class="form-select" style="width: auto; min-width: 200px; border-color: #0d6efd;" onchange="handleTimeFilterChange(this.value)">
                        <optgroup id="recentOptions" label="Recent Periods">
                            <option value="Today">Today</option>
                            <option value="Yesterday">Yesterday</option>
                            <option value="TwoWeeksAgo">Last 2 Weeks</option>
                            <option value="ThisWeek">This Week</option>
                            <option value="LastWeek">Last Week</option>
                        </optgroup>
                        <optgroup id="monthOptions" label="Monthly View">
                            @* Filled by buildMonthOptions() for the selected year *@
                        </optgroup>
                    </select>
                  </div>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="wfm-tab" data-bs-toggle="tab" data-bs-target="#wfm" type="button" role="tab" aria-controls="wfm" aria-selected="true">Zoom WFM Schedule</button>
        </li>
    </ul>
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active" id="wfm" role="tabpanel" aria-labelledby="wfm-tab">
            <div style="position: relative;">
                <div id="wfmLoadingOverlay" style="display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,0.8); z-index: 1000; text-align: center; padding-top: 200px;">
                    Loading schedule...
                </div>

                <div style="float: left; margin-bottom: 10px;">
                    <button id="wfmExpandAll" class="btn btn-outline-secondary btn-sm" type="button">
                        <i class="fas fa-plus-square me-1"></i>Expand all
                    </button>
                    <button id="wfmCollapseAll" class="btn btn-outline-secondary btn-sm ms-1" type="button">
                        <i class="fas fa-minus-square me-1"></i>Collapse all
                    </button>
                </div>

                <div style="text-align: right; margin-bottom: 10px; padding: 5px 10px; background-color: #f8f9fa; border-radius: 5px; display: inline-block; float: right;">
                    <span style="font-weight: 500; color: #0d6efd;">Scheduled:</span>
                    <span id="wfmTotalScheduled" style="margin-left: 5px; font-weight: bold;">Loading...</span>
                    <span style="font-weight: 500; color: #0d6efd; margin-left: 15px;">Paid:</span>
                    <span id="wfmTotalPaid" style="margin-left: 5px; font-weight: bold;">Loading...</span>
                </div>
                <div style="clear: both;"></div>

                <div id="wfmScheduleTable"></div>

                <div id="wfmNoDataMessage" style="display: none; text-align: center; padding: 20px; color: #6c757d;">
                    No schedule data for this period. The schedule syncs from Zoom once a day.
                </div>
            </div>

@if (Model.CanImportMetrics)
{
            @* Divider and panel styled like the sections under the main page's table *@
            <div style="margin: 30px 0; text-align: center;">
                <div style="display: inline-block; width: 100%; height: 2px; background: linear-gradient(to right, transparent, #20c997, transparent);"></div>
            </div>

            <div style="background-color: #f8f9fa; padding: 15px; border-radius: 5px; border: 1px solid #dee2e6;">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <span style="font-weight: 500; color: #0d6efd;">
                        <i class="fas fa-file-csv me-1"></i>Import Zendesk metrics:
                    </span>
                    <input type="file" id="zendeskFile" accept=".csv" class="form-control form-control-sm" style="width: auto;" />
                    <select id="zendeskYear" class="form-select form-select-sm" style="width: auto;">
                        @{
                            var thisYear = DateTime.Now.Year;
                            for (int y = thisYear; y >= thisYear - 3; y--)
                            {
                                <option value="@y">@y</option>
                            }
                        }
                    </select>
                    <select id="zendeskMonth" class="form-select form-select-sm" style="width: auto;">
                        @{
                            var defaultMonth = DateTime.Now.AddMonths(-1).Month;
                            for (int m = 1; m <= 12; m++)
                            {
                                var label = new DateTime(2000, m, 1).ToString("MMMM");
                                if (m == defaultMonth)
                                {
                                    <option value="@m" selected>@label</option>
                                }
                                else
                                {
                                    <option value="@m">@label</option>
                                }
                            }
                        }
                    </select>
                    <button id="zendeskImportButton" class="btn btn-outline-primary btn-sm" type="button">
                        <span id="zendeskImportSpinner" class="spinner-border spinner-border-sm me-1" role="status" style="display: none;">
                            <span class="visually-hidden">Importing...</span>
                        </span>
                        Import
                    </button>
                </div>
                <div style="font-size: 0.75rem; color: #6c757d; margin-top: 6px;">
                    The month applies to the Agent Table export only - the By-Month export carries its own months.
                </div>
                <div id="zendeskImportAlert" class="alert mt-2 mb-0" style="display: none;"></div>
            </div>
}
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/tabulator/5.0.7/js/tabulator.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabulator/5.0.7/css/tabulator.min.css">

    <script>
        var wfmScheduleTable = null;
        var wfmTableReady = null;

        // How many years back the Year dropdown offers (current year included)
        const YEARS_TO_SHOW = 3;
        const MONTH_NAMES = ["January", "February", "March", "April", "May", "June",
                             "July", "August", "September", "October", "November", "December"];

        function getSelectedYear() {
            const value = parseInt(document.getElementById('yearFilter').value);
            return isNaN(value) ? new Date().getFullYear() : value;
        }

        function buildYearOptions() {
            const select = document.getElementById('yearFilter');
            const currentYear = new Date().getFullYear();
            select.innerHTML = '';
            for (let year = currentYear; year > currentYear - YEARS_TO_SHOW; year--) {
                select.add(new Option(year, year));
            }
            select.value = currentYear;
        }

        // Lists only months that have started: up to this month for the current year, all 12 for past years
        function buildMonthOptions(year) {
            const group = document.getElementById('monthOptions');
            const now = new Date();
            const lastMonth = year === now.getFullYear() ? now.getMonth() + 1 : 12;
            group.label = `${year} Months`;
            group.innerHTML = '';
            for (let month = 1; month <= lastMonth; month++) {
                const value = `Month_${year}_${String(month).padStart(2, '0')}`;
                group.appendChild(new Option(MONTH_NAMES[month - 1], value));
            }
        }

        // Today / This Week / etc. are relative to today, so they're only offered for the current year
        const recentPeriods = document.getElementById('recentOptions');
        function setRecentPeriodsVisible(visible) {
            const select = document.getElementById('timeFilter');
            if (visible && !recentPeriods.isConnected) select.insertBefore(recentPeriods, select.firstChild);
            if (!visible && recentPeriods.isConnected) recentPeriods.remove();
        }

        function handleYearChange(yearValue) {
            const year = parseInt(yearValue);
            const isCurrentYear = year === new Date().getFullYear();
            const select = document.getElementById('timeFilter');
            const previousValue = select.value;

            buildMonthOptions(year);
            setRecentPeriodsVisible(isCurrentYear);

            if (previousValue.startsWith('Month_') || !isCurrentYear) {
                // Keep the same month in the new year (a recent period maps to this month),
                // or the latest available one
                const month = previousValue.startsWith('Month_')
                    ? previousValue.split('_')[2]
                    : String(new Date().getMonth() + 1).padStart(2, '0');
                const sameMonth = `Month_${year}_${month}`;
                const options = document.getElementById('monthOptions').querySelectorAll('option');
                select.value = Array.from(options).some(o => o.value === sameMonth)
                    ? sameMonth
                    : options[options.length - 1].value;
                handleTimeFilterChange(select.value);
            } else {
                select.value = previousValue;
            }
        }

        buildYearOptions();
        buildMonthOptions(getSelectedYear());

        function formatMinutes(minutes) {
            if (!minutes) return '0m';
            const hours = Math.floor(minutes / 60);
            const remainder = minutes % 60;
            if (hours === 0) return `${remainder}m`;
            return remainder === 0 ? `${hours}h` : `${hours}h ${remainder}m`;
        }

        function currentGroupBy() {
            return document.getElementById('wfmGroupBy').value;
        }

        // Tabulator builds asynchronously, so setData has to wait for tableBuilt - called any
        // earlier the data is silently dropped and the table renders empty.
        function initWfmTable() {
            if (wfmTableReady) return wfmTableReady;

            wfmScheduleTable = new Tabulator("#wfmScheduleTable", {
                layout: "fitColumns",
                dataTree: true,
                dataTreeStartExpanded: false,
                dataTreeChildField: "children",
                height: "600px",
                data: [],
                columns: [
                    { title: "Agent / Date / Activity", field: "agent", headerSort: false, widthGrow: 3 },
                    { title: "Type", field: "activityType", headerSort: false },
                    { title: "Time", field: "timeRange", headerSort: false },
                    { title: "Scheduled", field: "scheduled", hozAlign: "left" },
                    { title: "Paid", field: "paid", hozAlign: "left" },
                    { title: "Group", field: "schedulingGroup", headerSort: false },
                    { title: "% To Target", field: "percentToTarget", hozAlign: "right" }
                ]
            });

            wfmTableReady = new Promise(resolve => {
                wfmScheduleTable.on("tableBuilt", () => resolve(wfmScheduleTable));
            });

            return wfmTableReady;
        }

        // The first column holds a different level of the tree in each mode, so relabel it.
        // This writes the header text straight into the DOM on purpose: Tabulator's
        // updateColumnDefinition rebuilds the column, and rebuilding the tree column strips every
        // expand/collapse control off the table.
        function setTreeColumnTitle(groupBy) {
            const title = groupBy === 'group'
                ? 'Pod / Agent / Date / Activity'
                : 'Agent / Date / Activity';

            const titleElement = document.querySelector('#wfmScheduleTable .tabulator-col[tabulator-field="agent"] .tabulator-col-title');
            if (titleElement) {
                titleElement.textContent = title;
            }
        }

        // % To Target is monthly while the table's period can span months, so name the month in
        // the header rather than leaving it ambiguous.
        function setMetricsColumnTitle(monthLabel) {
            const titleElement = document.querySelector('#wfmScheduleTable .tabulator-col[tabulator-field="percentToTarget"] .tabulator-col-title');
            if (titleElement) {
                titleElement.textContent = monthLabel ? `% To Target (${monthLabel})` : '% To Target';
            }
        }

        // treeExpand only opens one level, so walk the whole branch.
        function expandBranch(row) {
            row.treeExpand();
            row.getTreeChildren().forEach(expandBranch);
        }

        function collapseBranch(row) {
            row.getTreeChildren().forEach(collapseBranch);
            row.treeCollapse();
        }

        // Rebuilt after every load so the list tracks the selected period. The current choice is
        // kept when it is still available, otherwise it falls back to showing everything.
        function populateActivityDropdown(activityNames, activityTypes) {
            const select = document.getElementById('wfmActivity');
            const previous = select.value;

            select.innerHTML = '';
            select.appendChild(new Option('All activities', 'all'));

            if (activityTypes && activityTypes.length) {
                const typeGroup = document.createElement('optgroup');
                typeGroup.label = 'By type';
                activityTypes.forEach(type => typeGroup.appendChild(new Option(type, `type:${type}`)));
                select.appendChild(typeGroup);
            }

            if (activityNames && activityNames.length) {
                const nameGroup = document.createElement('optgroup');
                nameGroup.label = 'By activity';
                activityNames.forEach(name => nameGroup.appendChild(new Option(name, `name:${name}`)));
                select.appendChild(nameGroup);
            }

            const stillAvailable = [...select.options].some(option => option.value === previous);
            select.value = stillAvailable ? previous : 'all';
        }

        function loadZoomSchedule() {
            const overlay = document.getElementById('wfmLoadingOverlay');
            const filterValue = document.getElementById('timeFilter').value;
            const groupBy = currentGroupBy();
            const activity = document.getElementById('wfmActivity').value || 'all';

            overlay.style.display = 'block';
            document.getElementById('wfmTotalScheduled').textContent = 'Loading...';
            document.getElementById('wfmTotalPaid').textContent = 'Loading...';

            fetch(`?handler=ZoomSchedule&filter=${encodeURIComponent(filterValue)}&groupBy=${encodeURIComponent(groupBy)}&activity=${encodeURIComponent(activity)}`)
                .then(response => response.json())
                .then(result => {
                    overlay.style.display = 'none';

                    if (!result.success) {
                        console.error('Error loading Zoom schedule:', result.error);
                        document.getElementById('wfmTotalScheduled').textContent = 'Error';
                        document.getElementById('wfmTotalPaid').textContent = 'Error';
                        return;
                    }

                    populateActivityDropdown(result.activityNames, result.activityTypes);

                    const data = result.data || [];
                    const noDataMessage = document.getElementById('wfmNoDataMessage');
                    const tableElement = document.getElementById('wfmScheduleTable');

                    if (data.length === 0) {
                        noDataMessage.style.display = 'block';
                        tableElement.style.display = 'none';
                        document.getElementById('wfmTotalScheduled').textContent = '0m';
                        document.getElementById('wfmTotalPaid').textContent = '0m';
                        if (wfmTableReady) wfmTableReady.then(table => table.clearData());
                        return;
                    }

                    noDataMessage.style.display = 'none';
                    tableElement.style.display = 'block';

                    // Top level rows are whole agents or whole pods depending on the mode, so
                    // either way they sum to the period total exactly once.
                    const totalScheduled = data.reduce((sum, row) => sum + (row.scheduledMinutes || 0), 0);
                    const totalPaid = data.reduce((sum, row) => sum + (row.paidMinutes || 0), 0);
                    document.getElementById('wfmTotalScheduled').textContent = formatMinutes(totalScheduled);
                    document.getElementById('wfmTotalPaid').textContent = formatMinutes(totalPaid);

                    initWfmTable().then(table => {
                        table.setData(data);
                        // The container may have been hidden when the table was built, which leaves
                        // the rows without a laid out height until it is redrawn.
                        table.redraw(true);
                        setTreeColumnTitle(groupBy);
                        setMetricsColumnTitle(result.metricsMonth);
                    });
                })
                .catch(error => {
                    console.error('Error loading Zoom schedule:', error);
                    overlay.style.display = 'none';
                    document.getElementById('wfmTotalScheduled').textContent = 'Error';
                    document.getElementById('wfmTotalPaid').textContent = 'Error';
                });
        }

        function formatSyncTime(timestamp) {
            // Stored in UTC; append 'Z' so it is not read as local, then render in Pacific.
            const syncTime = new Date(timestamp + 'Z');
            const timeStr = syncTime.toLocaleString('en-US', {
                month: 'short', day: 'numeric', hour: 'numeric', minute: 'numeric',
                timeZone: 'America/Los_Angeles', hour12: true
            });
            return `Last synced ${timeStr} (Pacific)`;
        }

        function loadZoomLastSync() {
            fetch('?handler=ZoomLastSync')
                .then(response => response.json())
                .then(result => {
                    document.getElementById('wfmLastSync').textContent = result.success
                        ? formatSyncTime(result.timestamp)
                        : 'Never synced';
                })
                .catch(error => {
                    console.error('Error loading last sync time:', error);
                    document.getElementById('wfmLastSync').textContent = 'Last sync time unavailable';
                });
        }

        // Same wording style as the main page's formatTotalHours ("7 hours 30 min")
        function formatHoursLong(totalMinutes) {
            if (totalMinutes < 60) return `${totalMinutes} minutes`;
            const hours = Math.floor(totalMinutes / 60);
            const minutes = totalMinutes % 60;
            const hoursText = `${hours} hour${hours !== 1 ? 's' : ''}`;
            return minutes === 0 ? hoursText : `${hoursText} ${minutes} min`;
        }

        function loadOtgHoursToday() {
            const target = document.getElementById('otgHoursToday');
            fetch('?handler=OtgMinutesToday')
                .then(response => response.json())
                .then(result => {
                    target.textContent = result.success
                        ? `Total OTG Hours Scheduled for Team Today: ${formatHoursLong(result.minutes)}`
                        : 'Total OTG Hours Scheduled for Team Today: unavailable';
                })
                .catch(error => {
                    console.error('Error loading OTG hours:', error);
                    target.textContent = 'Total OTG Hours Scheduled for Team Today: unavailable';
                });
        }

        function handleTimeFilterChange(value) {
            // Only months that have started are listed; the disabled guard is kept as a safeguard.
            const select = document.getElementById('timeFilter');
            const selectedOption = select.options[select.selectedIndex];

            if (selectedOption.disabled) {
                select.value = select.dataset.lastValue || 'ThisWeek';
                return;
            }

            select.dataset.lastValue = value;
            loadZoomSchedule();
        }

        // The import control only renders for permitted users; the handler re-checks the policy,
        // so a crafted request from anyone else is rejected server-side.
        function importZendeskMetrics() {
            const fileInput = document.getElementById('zendeskFile');
            const button = document.getElementById('zendeskImportButton');
            const spinner = document.getElementById('zendeskImportSpinner');
            const alertBox = document.getElementById('zendeskImportAlert');

            if (!fileInput.files || fileInput.files.length === 0) {
                alertBox.className = 'alert alert-warning mt-2 mb-0';
                alertBox.textContent = 'Choose a CSV file first.';
                alertBox.style.display = 'block';
                return;
            }

            const formData = new FormData();
            formData.append('csvFile', fileInput.files[0]);
            formData.append('year', document.getElementById('zendeskYear').value);
            formData.append('month', document.getElementById('zendeskMonth').value);

            button.disabled = true;
            spinner.style.display = 'inline-block';
            alertBox.style.display = 'none';

            fetch('?handler=ImportZendesk', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: formData
            })
                .then(response => response.json())
                .then(result => {
                    // An import that moved nothing is reported as a warning, not a success -
                    // it almost always means an already-imported file was picked by mistake.
                    alertBox.className = !result.success
                        ? 'alert alert-warning mt-2 mb-0'
                        : (result.nothingChanged ? 'alert alert-warning mt-2 mb-0' : 'alert alert-success mt-2 mb-0');

                    let text = result.message || 'Import finished.';
                    if (result.unmatchedAgents && result.unmatchedAgents.length) {
                        text += ` Unmatched (${result.unmatchedAgents.length}): ${result.unmatchedAgents.join(', ')}`;
                    }
                    alertBox.textContent = text;
                    alertBox.style.display = 'block';

                    if (result.success) {
                        fileInput.value = '';
                        loadZoomSchedule();
                    }
                })
                .catch(error => {
                    console.error('Error importing Zendesk metrics:', error);
                    alertBox.className = 'alert alert-danger mt-2 mb-0';
                    alertBox.textContent = 'The import request failed.';
                    alertBox.style.display = 'block';
                })
                .finally(() => {
                    button.disabled = false;
                    spinner.style.display = 'none';
                });
        }

        document.getElementById('zendeskImportButton')?.addEventListener('click', importZendeskMetrics);
        document.getElementById('wfmGroupBy').addEventListener('change', loadZoomSchedule);
        document.getElementById('wfmActivity').addEventListener('change', loadZoomSchedule);
        document.getElementById('refreshButton').addEventListener('click', () => {
            loadZoomSchedule();
            loadZoomLastSync();
            loadOtgHoursToday();
        });

        document.getElementById('wfmExpandAll').addEventListener('click', () => {
            if (!wfmTableReady) return;
            wfmTableReady.then(table => table.getRows().forEach(expandBranch));
        });

        document.getElementById('wfmCollapseAll').addEventListener('click', () => {
            if (!wfmTableReady) return;
            wfmTableReady.then(table => table.getRows().forEach(collapseBranch));
        });

        document.addEventListener("DOMContentLoaded", () => {
            loadZoomLastSync();
            loadZoomSchedule();
            loadOtgHoursToday();
        });
    </script>
</div>
